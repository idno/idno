{
    "name": "idno/idno",
    "description": "A social publishing platform.",
    "type": "project",
    "homepage": "https://idno.co/",
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org",
            "canonical": false
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "ext-curl": "*",
        "ext-date": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-Reflection": "*",
        "ext-session": "*",
        "ext-SimpleXML": "*",
        "ext-openssl": "*",
        "ext-gettext": "*",
        "mapkyca/php-ogp": "^1.0",
        "psr/log": "~3.0",
        "idno/torophp": "^3.0",
        "mf2/mf2": "0.5.1",
        "swiftmailer/swiftmailer": "6.3.0",
        "forkawesome/fork-awesome": "1.2",
        "twbs/bootstrap": "3.4.1",
        "ezyang/htmlpurifier": "4.19.1",
        "rmm5t/jquery-timeago": "1.6.7",
        "tinymce/tinymce": "^8.9.3",
        "symfony/event-dispatcher": "^8.0",
        "symfony/console": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/cache": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "simplepie/simplepie": "1.9.0",
        "mapkyca/mrclay_autop_known": "^1.0",
        "npm-asset/underscore": "~1.13",
        "npm-asset/bootstrap-accessibility-plugin": "^1.0",
        "npm-asset/bootstrap-toggle": "2.2.2",
        "npm-asset/exif-js": "2.3.0",
        "npm-asset/jquery": "3.7.1",
        "npm-asset/mediaelement": "7.1.0",
        "npm-asset/tinymce--tinymce-jquery": "2.3.1",
        "npm-asset/vanilla-fitvids": "^1.1",
        "idno/mentionjs": "^1.0",
        "indieweb/mention-client": "^1.2.1",
        "twig/twig": "^3.23",
        "masterminds/html5": "^2.7",
        "ramsey/uuid": "^4.1",
        "composer/installers": "^2",
        "vlucas/phpdotenv": "^5.3",
        "landrok/activitypub": "^0.8.1",
        "symfony/runtime": "^8.0",
        "symfony/monolog-bundle": "^4.1",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/migrations": "^3.9",
        "league/flysystem": "^3",
        "league/flysystem-async-aws-s3": "^3",
        "symfony/http-client": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/messenger": "^8.0",
        "symfony/doctrine-messenger": "^8.0"
    },
    "license": "Apache-2.0",
    "prefer-stable": true,
    "minimum-stability": "dev",
    "keywords": [
        "blogging",
        "publishing",
        "social",
        "indieweb",
        "community"
    ],
    "support": {
        "forum": "https://groups.google.com/forum/#!forum/known-dev",
        "docs": "http://docs.idno.co",
        "irc": "irc://irc.freenode.net/knownchat"
    },
    "autoload": {
        "psr-4": {
            "Idno\\": "Idno/",
            "IdnoPlugins\\": "IdnoPlugins/",
            "Themes\\": "Themes/",
            "ConsolePlugins\\": "ConsolePlugins/",
            "Tests\\": "Tests/"
        }
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "mapkyca/mapkyca-known-docker": "^1.0",
        "squizlabs/php_codesniffer": "4.*",
        "phpunit/phpunit": "^9.6",
        "league/flysystem-memory": "^3"
    },
    "extra": {
        "unused": [
            "masterminds/html5"
        ]
    },
    "suggest": {
        "ext-pdo_mysql": "A site on MySQL or MariaDB needs it; Idno needs this or ext-pdo_sqlite",
        "ext-pdo_sqlite": "A site on SQLite needs it (SQLite 3.38 or later); Idno needs this or ext-pdo_mysql",
        "ext-mongodb": "Only to import a MongoDB site into MySQL, MariaDB or SQLite (php bin/console idno:import:mongo)"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/known"
        }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "test:up": ["Composer\\Config::disableProcessTimeout", "Tests/rig/up.sh sqlite"],
        "test:up:mysql": ["Composer\\Config::disableProcessTimeout", "Tests/rig/up.sh mysql"],
        "test:down": ["Composer\\Config::disableProcessTimeout", "Tests/rig/down.sh"],
        "console": "php -d error_reporting=22527 bin/console",
        "test:unit": ["Composer\\Config::disableProcessTimeout", "php -d error_reporting=22527 vendor/bin/phpunit -c phpunit.unit.xml"],
        "test": ["Composer\\Config::disableProcessTimeout", "IDNO_DOMAIN=127.0.0.1 IDNO_PORT=8089 php -d error_reporting=22527 vendor/bin/phpunit"],
        "test:mongo-import": ["Composer\\Config::disableProcessTimeout", "Tests/rig/mongo-import.sh"]
    }
}
