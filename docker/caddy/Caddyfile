:80 {
	# compress stuff
	encode zstd gzip

	# our root is in /srv
	root * /app

	# Never serve or run the cache, kernel configuration, command-line scripts, tests, docs,
	# site configuration, uploads or git metadata (the same rules as .htaccess; see
	# docs/install/upgrade.md). Case-insensitive.
	@denied path_regexp denied (?i)^/((var|config|bin|tests|docs|data|frontend|warmup/cli|configuration|uploads|\.git|\.github)(/|$)|(idno|known)\.php$)
	respond @denied 403

	# A database file, its write-ahead log and shared memory, and the upgrade's lock file, wherever they are.
	@denied_files path_regexp denied_files (?i)\.(sqlite|sqlite-wal|sqlite-shm|upgrade\.lock)$
	respond @denied_files 403

        # Rewrites
        rewrite /js/canary.js /js/idno-2026.min.js
        @css path_regexp css ^/css/[0-9]+/(.*)$
        rewrite @css /css/{re.css.1}
        @js path_regexp js ^/js/[0-9]+/(.*)$
        rewrite @js /js/{re.js.1}

	# pass everything else to php
	php_fastcgi known:9000 {
		env HTTPS on
		env SERVER_PORT 443
	}

	file_server
}
