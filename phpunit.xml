<?xml version="1.0" encoding="UTF-8"?>
<phpunit colors="true" bootstrap="./Tests/_bootstrap.php">
    <testsuites>
        <testsuite name="Idno Basic Unit Tests">
            <directory>./Tests/</directory>
            <exclude>./Tests/Characterisation/</exclude>
        </testsuite>
        <testsuite name="Characterisation">
            <directory>./Tests/Characterisation/</directory>
        </testsuite>
	<testsuite name="Plugins">
	    <directory>./IdnoPlugins/*/Tests/</directory>
    	</testsuite>
    </testsuites>
    <php>
        <ini name="display_errors" value="On" />
        <ini name="display_startup_errors" value="On" />
        <ini name="memory_limit" value="256M" />
    </php>
</phpunit>