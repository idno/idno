{{ idno_include('entity/edit/header') -}}
<form action="{{ object.getURL() }}" method="post">

    <div class="idno-editor">

        <h4 class="idno-editor-heading">
            {% if not entity_value(object, '_id') %}{{ t('New Event') }}{% else %}{{ t('Edit Event') }}{% if object.getPublishStatus() == 'draft' %} <span class="idno-badge-draft">{{ t('Draft') }}</span>{% endif %}{% endif %}
        </h4>

        <div class="idno-form-field">
            <label class="idno-label" for="title">
                {{ t('Event name') }}</label>
            {{ idno_include('forms/input/input', {
                name: 'title',
                id: 'title',
                placeholder: t('Give it a name'),
                value: entity_value(object, 'title'),
                class: 'idno-input'
            }) }}
        </div>

        <div style="display:flex;gap:var(--spacing-gap);flex-wrap:wrap">
            <div style="flex:1;min-width:200px">
                <div class="idno-form-field">
                    <label class="idno-label" for="location">
                        {{ t('Location') }}</label>
                    {{ idno_include('forms/input/input', {
                        name: 'location',
                        id: 'location',
                        placeholder: t('Where will it take place?'),
                        value: entity_value(object, 'location'),
                        class: 'idno-input'
                    }) }}
                </div>

                <div class="idno-form-field">
                    <label class="idno-label" for="starttime">
                        {{ t('Start day and time') }}</label>
                    {{ idno_include('forms/input/datetime-local', {
                        name: 'starttime',
                        id: 'starttime',
                        placeholder: t('Type in the start day and time?'),
                        value: entity_value(object, 'starttime'),
                        class: 'idno-input'
                    }) }}
                </div>

                <div class="idno-form-field">
                    <label class="idno-label" for="endtime">
                        {{ t('End day and time') }}</label>
                    {{ idno_include('forms/input/datetime-local', {
                        name: 'endtime',
                        id: 'endtime',
                        placeholder: t('Type in the end day and time'),
                        value: entity_value(object, 'endtime'),
                        class: 'idno-input'
                    }) }}
                </div>

                <div class="idno-form-field">
                    <label class="idno-label" for="timezone">
                        {{ t('Time zone') }}</label>
                    {% set me = current_user() %}{{ idno_include('forms/input/timezones', {
                        name: 'timezone',
                        id: 'timezone',
                        required: true,
                        value: entity_value(object, 'timezone') ? entity_value(object, 'timezone') : me.getTimezone(),
                        class: 'idno-input'
                    }) }}
                </div>

                {{ idno_include('content/syndication', {services: syndication_services('event'), content_type: 'event', posseLinks: object.getPosseLinks()}) }}
            </div>

            <div style="flex:1;min-width:200px">
                <div class="idno-form-field">
                    <label class="idno-label" for="summary">
                        {{ t('Brief summary') }}</label>
                    {{ idno_include('forms/input/input', {
                        name: 'summary',
                        id: 'summary',
                        placeholder: t("What's this about?"),
                        value: entity_value(object, 'summary'),
                        class: 'idno-input'
                    }) }}
                </div>

                <div class="idno-form-field">
                    <label class="idno-label" for="body">
                        {{ t('Description') }}</label>
                    {{ idno_include('forms/input/richtext', {
                        height: '100', name: 'body', value: entity_value(object, 'body'), required: true
                    }) }}
                </div>

                {{ idno_include('entity/tags/input') }}
            </div>
        </div>

        {% if not entity_value(object, '_id') %}{{ idno_include('forms/input/hidden', {name: 'forward-to', value: site_url('content/all/')}) }}{% endif %}

        {{ idno_include('content/extra') }}
        {{ idno_include('content/access') }}

        {{ form_token('/event/edit') }}

        <div style="display:flex;gap:0.5rem;margin-top:var(--spacing-section)">
            <button type="submit" class="idno-btn idno-btn-primary" name="publish_status" value="published">
                {{ t('Publish') }}
            </button>
            <button type="submit" class="idno-btn idno-btn-ghost" name="publish_status" value="draft">
                {{ t('Save as Draft') }}
            </button>
            <a href="{{ entity_value(object, '_id') ? object.getDisplayURL() : site_url() }}" class="idno-btn idno-btn-ghost">
                {{ t('Cancel') }}
            </a>
        </div>

    </div>
</form>
<script>
    autoSave('event', ['title','summary','location','starttime','endtime','body']);
</script>
{{ idno_include('entity/edit/footer') }}
