{% set num_pics = object.getAttachments()|length %}{% set many_pics = num_pics > 1 %}

{{ idno_include('entity/edit/header') -}}
    <form action="{{ object.getURL() }}" method="post" enctype="multipart/form-data">

        <div class="idno-editor">

                <h4 class="idno-editor-heading">
                    {% if not entity_value(object, '_id') %}{{ t('New Photo') }}{% else %}{{ t('Edit Photo') }}{% if object.getPublishStatus() == 'draft' %} <span class="idno-badge-draft">{{ t('Draft') }}</span>{% endif %}{% endif %}
                </h4>

                <div class="idno-photo-files {% if many_pics %}multiple-images{% endif %}" data-num-pics="{{ num_pics }}">
                    {% for n in 0..9 %}
                        <div class="idno-image-file" data-number="{{ n }}" style="{% if n > 0 %}display: none;{% endif %}">
                            {{ idno_include('forms/input/image-file', {
                                name: 'photo[]',
                                'hide-existing': n > 0,
                                'hide-delete': n > 0
                            }) }}
                        </div>
                    {% endfor %}
                </div>

                <div id="photo-details">

                    <div class="idno-form-field">
                        <label class="idno-label" for="title">
                            {{ t('Title') }}</label>
                        {{ idno_include('forms/input/input', {
                            name: 'title',
                            id: 'title',
                            placeholder: t('Give it a title'),
                            value: entity_value(object, 'title'),
                            class: 'idno-input'
                        }) }}
                    </div>

                    {{ idno_include('forms/input/richtext', {
                        name: 'body',
                        value: entity_value(object, 'body'),
                        wordcount: false,
                        class: 'wysiwyg-short',
                        height: 100,
                        placeholder: t('Describe your photo'),
                        label: t('Description')
                    }) }}

                    {{ idno_include('entity/tags/input') }}

                </div>

                {{ idno_include('content/syndication', {services: syndication_services('image'), content_type: 'image', posseLinks: object.getPosseLinks()}) }}
                {% if not entity_value(object, '_id') %}{{ idno_include('forms/input/hidden', {name: 'forward-to', value: site_url('content/all/')}) }}{% endif %}
                {{ idno_include('content/extra') }}
                {{ idno_include('content/access') }}

                {{ form_token('/photo/edit') }}

                <div style="display:flex;gap:0.5rem;margin-top:var(--spacing-section)">
                    <button type="submit" class="idno-btn idno-btn-primary" name="publish_status" value="published">
                        {{ t('Publish') }}
                    </button>
                    <button type="submit" class="idno-btn idno-btn-ghost" name="publish_status" value="draft">
                        {{ t('Save as Draft') }}
                    </button>
                    <a href="{{ entity_value(object, '_id') ? object.getDisplayURL() : site_url() }}" class="idno-btn idno-btn-ghost">
                        {{ t('Cancel') }}
                    </a>
                </div>

        </div>
    </form>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.idno-photo-files input').forEach(function(input) {
            input.addEventListener('change', function() {
                var imageFile = this.closest('div.idno-image-file');
                var number = parseInt(imageFile.getAttribute('data-number')) + 1;
                var next = document.querySelector('.idno-photo-files .idno-image-file[data-number="' + number + '"]');
                if (next) next.style.display = '';
            });
        });
    });
</script>

{{ idno_include('entity/edit/footer') }}
