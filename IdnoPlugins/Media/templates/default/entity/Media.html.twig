{% set rel = is_permalink() ? 'rel="in-reply-to"' : '' %}{% set post_tags = entity_value(object, 'tags') %}{% set tags_html = post_tags ? idno_include('forms/output/tags', {tags: post_tags}) : '' %}
{% if not feed_view %}
        <h2 class="p-name">
             <a href="{{ object.getDisplayURL() }}">{{ object.getTitle()|striptags }}</a>
        </h2>
{% endif %}
{# The browser's own player: the file is the attachment's address, through the site's file route. #}
{% if not feed_view %}{% set attachments = object.getAttachments() %}{% if attachments %}{% if ((entity_value(object, 'media_type') ?? '')|slice(0, 5)) == 'video' %}
                <p style="text-align: center">
                    <video class="u-video" controls preload="none" style="width: 100%">
                    {% for attachment in attachments %}{% if attachment.url|http_url %}
                            <source src="{{ attachment.url|http_url }}" type="{{ attachment['mime-type'] ?? '' }}">
                    {% endif %}{% endfor %}

                        {{ t('Sorry, your browser does not support the video tag.') }}
                    </video>
                </p>
{% else %}{% for attachment in attachments %}{% if attachment.url|http_url %}
                <p>
                    <audio class="u-audio" controls preload="none" style="width: 100%" src="{{ attachment.url|http_url }}">
                        {{ t('Sorry, your browser does not support the audio tag.') }}
                    </audio>
                </p>
{% endif %}{% endfor %}{% endif %}{% endif %}{% endif %}
<div class="e-content">
{{ entity_value(object, 'body')|sanitize_html|parse_urls(rel)|parse_hashtags|autop }}{{ tags_html }}
</div>
