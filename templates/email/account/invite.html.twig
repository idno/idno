<div style="font-weight: bold; font-size: 30px; line-height: 32px; color: #333" align="center">
    {{ t('Join us!') }}
</div><br>
<hr/>
<br>
{% set site_link %}a href="{{ site_url() }}" style="color: #73b2e3; text-decoration: none;">{{ site_title() }}</a{% endset -%}
{{ t_html('Hi there! Your friend <strong>%s</strong> has invited you to join <%s>', [inviter, site_link]) }}.
<br><br>
{{ t('You can use this space to publish your stories, share things that interest you, and discuss things that matter.') -}}
<br><br>
{{ t_html('Get started with <strong>%s</strong> by setting up your account', [site_title()]) }}.
<br><br>
<div align="center">
<a href="{{ site_url() }}account/register/?email={{ email|form_urlencode }}&code={{ code|form_urlencode }}" style="background-color:#73B2E3;border:1px solid #73B2E3;border-radius:4px;color:#ffffff;display:inline-block;font-family:sans-serif;font-size:17px;font-weight:normal;line-height:40px;text-align:center;text-decoration:none;width:200px;-webkit-text-size-adjust:none;mso-hide:all;">{{ t('Sign up now') }}</a>
</div>
<br>
{% set contact %}<a href="mailto:{{ setting('from_email')|email_address }}" style="color: #73b2e3; text-decoration: none;">{{ setting('from_email') }}</a>{% endset -%}
{{ t_html('If you have any questions at all, please don\'t hesitate to contact us by sending an email to %s', [contact]) }}.

<br><br>
