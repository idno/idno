{#- The password reset mail: `email`, `code`. The plain-text twin is templates/email-text/account/password. -#}
{%- set site = mail_site_name() -%}
{%- set reset = mail_url() ~ 'account/password/reset/?email=' ~ (email|default('')|form_urlencode) ~ '&code=' ~ (code|default('')|form_urlencode) -%}
{%- do mail_describe({
    subject: t('Reset your password for %s', [site]),
    preheader: t('Choose a new password within three hours.'),
    reason: t('You got this email because somebody asked to reset the password of the account with this address on %s.', [site]),
}) -%}
{{ idno_include('parts/heading', {text: t('Reset your password')}) }}
{{ idno_include('parts/paragraph', {format: t_format('Somebody, probably you, asked to reset the password of your account on %s.'), values: [site]}) }}
{{ idno_include('parts/paragraph', {text: t('To choose a new password, use this link within three hours:')}) }}
{{ idno_include('parts/button', {label: t('Choose a new password'), url: reset}) }}
{{ idno_include('parts/paragraph', {muted: true, text: t("If you didn't ask for this, you can ignore this email: your password stays as it is.")}) }}
