{#- The main thing to do in a mail: `label`, `url`. A table cell with a background, which every mail client draws, and for Outlook on Windows (which ignores padding on a
    link) a VML shape of the same size. The address is printed underneath for a reader whose client shows neither, or who would rather copy it. The label and its background
    are set together, on the cell and on the link, so that a mail client that turns colours over turns both; the border keeps the button's shape where only the card around
    it has turned dark. -#}
{%- set href = url|http_url -%}
{%- if href -%}
{%- set label = label|mail_one_line -%}
{%- set fill = mail_colour('button', 'background-color') -%}
{%- set ink = mail_colour('button') -%}
{%- set edge = mail_colour('button', 'border-color') -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 8px 0 16px 0;">
    <tr>
        <td class="idno-mail-button" align="center" bgcolor="{{ fill }}" style="background-color: {{ fill }}; color: {{ ink }}; border-radius: 8px;">
            <!--[if mso]>
            <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ href }}" style="height:46px;v-text-anchor:middle;width:{{ max(180, 48 + 10 * (label|length)) }}px;" arcsize="18%" strokecolor="{{ edge }}" fillcolor="{{ fill }}">
            <w:anchorlock/>
            <center style="color:{{ ink }};font-family:'Segoe UI',Arial,sans-serif;font-size:16px;font-weight:bold;">{{ label }}</center>
            </v:roundrect>
            <![endif]-->
            <!--[if !mso]><!-- -->
            <a class="idno-mail-button" href="{{ href }}" style="display: inline-block; padding: 10px 23px; background-color: {{ fill }}; border: 1px solid {{ edge }}; border-radius: 8px; font-family: {{ mail_font() }}; font-size: 16px; line-height: 24px; font-weight: 600; color: {{ ink }}; text-decoration: none;">{{ label }}</a>
            <!--<![endif]-->
        </td>
    </tr>
</table>
<p class="idno-mail-muted" style="margin: 0 0 16px 0; font-family: {{ mail_font() }}; font-size: 14px; line-height: 21px; color: {{ mail_colour('muted') }};">{{ t('Or copy this address into your browser:') }}<br>
<a class="idno-mail-link" href="{{ href }}" style="color: {{ mail_colour('link') }}; text-decoration: underline; word-break: break-all;">{{ href }}</a></p>
{% endif %}
