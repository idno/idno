{# Words somebody typed, set apart from the mail's own: `text` (line breaks are kept) #}
{% if text|trim %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin: 0 0 16px 0;">
    <tr>
        <td class="idno-mail-box" bgcolor="{{ mail_colour('box', 'background-color') }}" style="padding: 12px 16px; background-color: {{ mail_colour('box', 'background-color') }}; border-left: 3px solid {{ mail_colour('box', 'border-color') }}; border-radius: 0 8px 8px 0; font-family: {{ mail_font() }}; font-size: 15px; line-height: 23px; color: {{ mail_colour('box') }}; word-break: break-word;">{{ text|trim|nl2br }}</td>
    </tr>
</table>
{% endif %}
