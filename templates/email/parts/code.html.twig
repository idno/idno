{# Preformatted text (an error message): `text`. Long lines wrap; nothing is wider than the mail. #}
{% if text|trim %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; table-layout: fixed; margin: 0 0 16px 0;">
    <tr>
        <td class="idno-mail-box" bgcolor="{{ mail_colour('box', 'background-color') }}" style="padding: 12px 14px; background-color: {{ mail_colour('box', 'background-color') }}; border: 1px solid {{ mail_colour('box', 'border-color') }}; border-radius: 8px; font-family: {{ mail_font(true) }}; font-size: 13px; line-height: 20px; color: {{ mail_colour('box') }}; white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere;">{{ text|trim }}</td>
    </tr>
</table>
{% endif %}
