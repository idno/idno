{#- The mail to the addresses of the oops_notify setting when the site hits an error (Logging::oopsAlert()): `title` (the kind of error), `message`, `user`, `agent`, `qs`, `referrer`. The last
    three come from the request as they were sent, and the message can repeat text from it: the parts escape them all. The plain-text twin is templates/email-text/admin/oops. -#}
{%- set host = (site|default(site_url()))|url_host|default(mail_site_name()) -%}
{%- set kind = title|default('')|mail_one_line -%}
{%- do mail_describe({
    subject: t('Error on %s', [host]) ~ (kind ? ': ' ~ kind : ''),
    preheader: message|default('')|mail_one_line|slice(0, 140),
    reason: t('You got this email because this address is set to be told about errors on %s (the oops_notify setting).', [mail_site_name()]),
}) -%}
{{ idno_include('parts/heading', {text: t('An error occurred on %s', [host])}) }}
{% if kind %}
{{ idno_include('parts/paragraph', {text: kind}) }}
{% endif %}
{{ idno_include('parts/code', {text: message|default('')}) }}
{{ idno_include('parts/rows', {rows: {
    (t('Signed-in member')): (user|default('')|mail_one_line in ['', 'UNKNOWN']) ? t('Nobody') : user,
    (t('Browser')): agent|default(''),
    (t('Query string')): qs|default(''),
    (t('Referrer')): referrer|default(''),
}}) }}
