{#- Tells the administrator who asked for an export that it did not work. No variables. The plain-text twin is templates/email-text/admin/export_failure. -#}
{%- set site = mail_site_name() -%}
{%- do mail_describe({
    subject: t('Your export of %s did not finish', [site]),
    preheader: t('The archive could not be made.'),
    reason: t('You got this email because you asked for an export of %s.', [site]),
}) -%}
{{ idno_include('parts/heading', {text: t('Your export did not finish')}) }}
{{ idno_include('parts/paragraph', {format: t_format('The archive of %s could not be made.'), values: [site]}) }}
{{ idno_include('parts/paragraph', {text: t("You can try the export again. If it fails again, the site's error log may say why.")}) }}
{{ idno_include('parts/button', {label: t('Try the export again'), url: mail_url() ~ 'admin/export/'}) }}
