{#- The test mail an administrator sends from the email settings. No variables. The plain-text twin is templates/email-text/admin/emailtest. -#}
{%- set site = mail_site_name() -%}
{%- do mail_describe({
    subject: t('Test email from %s', [site]),
    preheader: t('If you can read this, the email settings work.'),
    reason: t('You got this email because an administrator of %s sent a test to this address.', [site]),
}) -%}
{{ idno_include('parts/heading', {text: t('The email settings work')}) }}
{{ idno_include('parts/paragraph', {format: t_format('If you can read this, %s can send email.'), values: [site]}) }}
{{ idno_include('parts/paragraph', {text: t('If it arrived in the spam folder, check the DNS records your mail service asks for (SPF, DKIM and DMARC).')}) }}
{{ idno_include('parts/button', {label: t('Back to the email settings'), url: mail_url() ~ 'admin/email/'}) }}
