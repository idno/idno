{#- Tells the administrator who started an import that it is done: `imported` and `skipped` (counts). The plain-text twin is templates/email-text/admin/import. -#}
{%- set site = mail_site_name() -%}
{%- do mail_describe({
    subject: t('Your import into %s is complete', [site]),
    preheader: t('The posts from your file are on the site.'),
    reason: t('You got this email because you started an import into %s.', [site]),
}) -%}
{{ idno_include('parts/heading', {text: t('Your import is complete')}) }}
{{ idno_include('parts/paragraph', {format: t_format('The file you uploaded has been turned into posts on %s.'), values: [site]}) }}
{% if imported|default(0)|to_int %}
{{ idno_include('parts/paragraph', {text: (skipped|default(0)|to_int) ? t('%s posts were imported, and %s items in the file were not (pages, attachments, other types, or items that could not be imported).', [imported|to_int, skipped|to_int]) : t('%s posts were imported.', [imported|to_int])}) }}
{% endif %}
{{ idno_include('parts/button', {label: t('Visit your site'), url: site_url()}) }}
