{% set parts = [] %}{% if services is not empty %}{% set posse_links = posseLinks ?? [] %}{% for service in services %}{% if syndication_has(service) %}{% set button = idno_include('content/syndication/' ~ service) %}{% if button is empty %}{% set accounts = syndication_accounts(service) %}{% if accounts is not empty %}{% set button = '' %}{% for account in accounts %}{% set disabled = '' %}{% if posse_links[service] is defined and posse_links[service] is iterable %}{% for posse_account in posse_links[service] %}{% if posse_account.account_id is same as(account.username) %}{% set disabled = 'disabled' %}{% endif %}{% endfor %}{% endif %}{# give plugins a chance to pre-select a service (e.g. if replying to a tweet, pre-select twitter) #}{% set parts = parts|merge([idno_include('content/syndication/account', {service: service, disabled: disabled, username: account.username, name: account.name, details: account, selected: syndication_selected(service, account.username)})]) %}{% endfor %}{% else %}{% set parts = parts|merge([idno_include('content/syndication/button', {service: service, disabled: posse_links[service] is defined ? 'disabled' : '', selected: syndication_selected(service)})]) %}{% endif %}{% else %}{% set parts = parts|merge([button]) %}{% endif %}{% endif %}{% endfor %}{% endif %}{% set buttons %}{% for part in parts %}{{ part }}{% endfor %}{{ idno_include('content/syndication/buttons') }}{% endset %}{% if buttons is not empty %}<p class="syndication">{{ buttons }}</p>{% endif %}
