{% if service is not empty and username is not empty %}{% set display_name = name is empty ? username : name %}{% set identifier = username|alnum_only %}{% set human_name %}{% for part in display_name|split(' ') %}{% if not loop.first %}&nbsp;{% endif %}{{ part }}{% endfor %}{% endset %}{% set human_icon = idno_include('content/syndication/icon/' ~ service) %}{% if human_icon is empty %}{% set human_icon = idno_include('content/syndication/icon/generic') %}{% endif %}
        <span class="syndication-toggle">
            <input type="checkbox" class="checkbox" {{ disabled }} name="syndication[]" id="syndication_{{ service }}_{{ identifier }}_toggle" value="{{ service }}::{{ username }}" data-toggle="toggle" data-onstyle="info" data-on="{{ human_icon|e }}&nbsp;{{ human_name }}" data-off="{{ human_icon|e }}&nbsp;{{ human_name }}" {% if selected %}checked{% endif %}>
        </span>
    {% endif %}
