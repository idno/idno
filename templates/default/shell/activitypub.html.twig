{% set alt_link = '' %}{% set entity = page_entity() %}{% if is_user(entity) %}{% set alt_link = entity.getActivityPubActorID() %}{% elseif is_entity(entity) and entity.isPublic() and (entity.getPublishStatus() is empty or entity.getPublishStatus() == 'published') %}{% set alt_link = entity.getUUID() %}{% endif %}
{% set alt_link = alt_link|http_url %}
{% if alt_link %}
    <link rel="alternate" type="application/activity+json" href="{{ alt_link }}" />
    {% endif %}
