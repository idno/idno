{% if not title %}{% if description %}{% set title = description|striptags|split(' ')|slice(0, 10)|join(' ') %}{% else %}{% set title = '' %}{% endif %}{% endif %}{% if not description %}{% set description = '' %}{% endif %}<!doctype html>
<html>
    <head>
        <meta charset="utf-8">
        <title>{{ title }}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="{{ description|striptags }}">
        <meta name="generator" content="Idno https://idno.co">
        {{ idno_include('shell/favicon') }}
        <link rel="schema.DC" href="http://purl.org/dc/elements/1.1/">
        <meta name="DC.title" content="{{ title }}">
        <meta name="DC.description" content="{{ description }}">{% if is_permalink() %}{% set creator = object.getOwner() %}{% if creator %}
                    <meta name="DC.creator" content="{{ creator.getTitle() }}">{% endif %}{% set created = entity_value(object, 'created') %}{% if created %}
                    <meta name="DC.date" content="{{ created|date('c') }}">{% endif %}{% set identifier = object.getDisplayURL() %}{% if identifier %}
                    <meta name="DC.identifier" content="{{ identifier }}">{% endif %}{% endif %}
        <link rel="alternate feed" type="application/rss+xml"
              title="{{ site_title() }}: all content"
              href="{{ site_url() }}content/all?_t=rss"/>
        <link href="{{ site_url() }}webmention/" rel="http://webmention.org/"/>
        <link href="{{ site_url() }}webmention/" rel="webmention"/>
        <link href="{{ static_url('css/idno-simple.min.css') }}" rel="stylesheet">
        <link href="//fonts.googleapis.com/css?family=Pontano+Sans" rel="stylesheet" type="text/css">
        <link href="//fonts.googleapis.com/css?family=Open+Sans:400,300,600,700,800" rel='stylesheet' type='text/css'>
        <script src="{{ static_url('vendor/npm-asset/jquery/dist/jquery.min.js') }}"></script>
        {{ idno_include('shell/simple/head') }}

        {% if bootstrap %}

                <link href="{{ static_url('vendor/twbs/bootstrap/dist/css/bootstrap.min.css') }}"
                      rel="stylesheet">
                <link rel="stylesheet"
                      href="{{ static_url('vendor/forkawesome/fork-awesome/css/fork-awesome.min.css') }}">
                <style>
                    body {
                        padding-top: 10px; /* 60px to make the container go all the way to the bottom of the topbar */
                    }
                </style>
                <link
                    href="{{ static_url('external/bootstrap/') }}assets/css/bootstrap-responsive.css"
                    rel="stylesheet">

            {% endif %}

        <!-- Syndication -->
        <link href="{{ static_url('vendor/npm-asset/bootstrap-toggle/css/bootstrap2-toggle.min.css') }}" rel="stylesheet" />
        <script src="{{ static_url('vendor/npm-asset/bootstrap-toggle/js/bootstrap2-toggle.min.js') }}"></script>

    </head>
    <body class="{{ body_classes()|split(' ')|first }}{% set page_class = '' %}{% for element in current_path()|split('/') %}{% if element %}{% set page_class = page_class ? page_class ~ '-' ~ element : element %}{{ ' page-' ~ page_class }}{% endif %}{% endfor %}">
        {{ body|raw }}
        {{ idno_include('shell/simple/footer') }}
    </body>
</html>
