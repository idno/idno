{% set feed = object.getFeedObject() %}{% if feed %}
    <div class="row subscription">
        <div class="col-md-10 col-md-offset-1">
            <p>
                <strong><a href="{{ entity_value(feed, 'url')|http_url }}">{{ feed.getTitle() }}</a></strong><br>
                <span class="feed_url">{{ entity_value(feed, 'feed_url') }}</span>
            </p>
        </div>
    </div>
    {% endif %}
