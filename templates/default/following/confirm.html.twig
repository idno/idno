<div class="row">

    <div class="col-md-10 col-md-offset-1">

        <form action="{{ site_url() }}following/confirm/" method="post">
            <h1>
                Follow {{ feed.getTitle() }}? <input type="submit" class="btn btn-primary" value="{{ t('Follow') }}">
                <input type="hidden" name="feed" value="{{ feed.getDisplayURL() }}">
                {{ form_token('following/confirm') }}
            </h1>
            <p class="explanation">
                {{ t("Here's the latest content.") }}
            </p>
        </form>

    </div>

</div>
{% if items is not empty %}{% for item in items %}

        {{ item.draw()|raw }}

        {% endfor %}{% endif %}
