{#- "You can't see this". For a visitor of a private site it is the front door: it says the site is private and how to get in. For a member it says their account lacks the permission, and offers no sign-in: they have signed in. No script: a visitor is not sent on to the sign-in page by one (the link keeps the id `soft-forward`). -#}
<div class="idno-gate idno-gate-wide">
    <div class="idno-editor">
        {% if not is_logged_in() %}
            {% if setting('walled_garden') %}
                <h1 class="idno-editor-heading">{{ t('%s is private', [site_title()]) }}</h1>
                <p class="idno-gate-lead">{{ t('Only members can read this community. If you are a member, sign in. If you have been invited, use the link in your invitation email to create your account.') }}</p>
            {% else %}
                <h1 class="idno-editor-heading">{{ t('Sign in to continue') }}</h1>
                <p class="idno-gate-lead">{{ t('You need to be signed in to see this page.') }}</p>
            {% endif %}
            <div class="idno-gate-actions">
                <a id="soft-forward" class="idno-btn idno-btn-primary" href="{{ login_url_for(current_url_parts().path) }}">{{ t('Sign in') }}</a>
            </div>
            <p class="idno-gate-foot">
                <a href="{{ site_url() }}account/password">{{ t('Forgot your password?') }}</a>
            </p>
        {% else %}
            <h1 class="idno-editor-heading p-name">{{ t("You don't have access to this page") }}</h1>
            <p class="idno-gate-lead">{{ t("Your account doesn't have the permissions this page needs.") }}</p>
            <div class="idno-gate-actions">
                <a class="idno-btn idno-btn-primary" href="{{ site_url() }}">{{ t('Go to the home page') }}</a>
            </div>
        {% endif %}
    </div>
</div>
