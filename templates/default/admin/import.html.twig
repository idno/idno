<h1 class="idno-admin-page-title">{{ t('Import') }}</h1>
    <p class="idno-admin-description">
        {{ t('Import your content from other sites into Idno. All imported content will be treated as a post, with a title and body content. Posts that are private or drafts at their source stay private or drafts here, and nothing you import is announced to your followers.') }}
    </p>
    <p class="idno-admin-description">
        {{ t('Importing the same file twice creates the posts twice.') }}
    </p>

    <div class="idno-admin-card">
        <h2 class="idno-admin-card-title">{{ t('WordPress') }}</h2>
        <form action="{{ site_url() }}admin/import/" method="post" enctype="multipart/form-data">
            <p>
                {{ t('Upload a WordPress XML file and turn it into Idno posts.') }} {{ t('An RSS file exported from another Idno site can be imported here too.') }}
            </p>
            <div class="idno-form-group">
                <label class="idno-label">{{ t('Select WordPress export file') }}</label>
                <input type="file" name="import" accept=".xml,.atom,.rss" class="idno-input">
            </div>
            <div class="idno-form-group">
                {{ form_token('/admin/import') }}
                <input type="hidden" name="import_type" value="WordPress">
                <button type="submit" class="idno-btn idno-btn-primary">{{ t('Import your data') }}</button>
            </div>
        </form>
    </div>

    <div class="idno-admin-card">
        <h2 class="idno-admin-card-title">{{ t('Blogger') }}</h2>
        <form action="{{ site_url() }}admin/import/" method="post" enctype="multipart/form-data">
            <p>
                {{ t('Upload a Blogger XML file and turn it into Idno posts.') }}
            </p>
            <div class="idno-form-group">
                <label class="idno-label">{{ t('Select Blogger export file') }}</label>
                <input type="file" name="import" accept=".xml,.atom" class="idno-input">
            </div>
            <div class="idno-form-group">
                {{ form_token('/admin/import') }}
                <input type="hidden" name="import_type" value="Blogger">
                <button type="submit" class="idno-btn idno-btn-primary">{{ t('Import your data') }}</button>
            </div>
        </form>
    </div>
