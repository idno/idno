<div class="row">

    <div class="col-md-10 col-md-offset-1">
                {{ idno_include('admin/menu') }}
        <h1>
            {{ t('Homepage content') }}
        </h1>

        <div class="explanation">
            <p>
                {{ t('Here you can choose what content visitors see on your site homepage. By default, all published content appears on the main page. If you want to hide some content types from the main page, you can turn them off below.') }}
            </p>
        </div>

        
        <div class="explanation">{{ t('Turn off content types to hide them from the homepage of your site.') }}
        </div>
        <br>
        <form action="{{ site_url() }}admin/homepage" method="post"
              class="form-horizontal" enctype="multipart/form-data">

            <div class="control-group">
                <div class="">
                    {% for content_type in content_types ?? [] %}

                                <div class="content-type">
                                    <div class="row">
                                    <div class="col-md-2">
                                        
                                        <label class="homepage_{{ content_type.getCategoryTitleSlug() }}"
                                               for="homepage_toggle_{{ content_type.getCategoryTitleSlug() }}">
                                            <strong>{{ content_type.getCategoryTitle() }}</strong>
                                        </label>
                                    </div>
                                    <div class="config-toggle col-md-4">
                                        
                                        <input type="checkbox" data-toggle="toggle" data-onstyle="info" name="default_feed_content[]"

                           data-on="{{ t('On') }}"
                           data-off="{{ t('Off') }}"

                                               value="{{ content_type.getCategoryTitleSlug() }}" {% if content_type.getEntityClass() in default_content_types %}checked="checked"{% endif %}
                                        />

                                    </div>
                                    </div>
                                </div>

                    {% endfor %}
                </div>
            </div>
            
            <div class="control-group">
                <div class="">
                    <button type="submit" class="btn btn-primary">{{ t('Save') }}</button>
                </div>
            </div>
            {{ form_token('/admin/homepage') }}

        </form>
    </div>

</div>
