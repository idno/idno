<h1 class="idno-admin-page-title">{{ t('Email') }}</h1>
    <p class="idno-admin-description">
        {{ t("Idno tries to send email using your server's default email settings. If you'd like it to do something else - for example, if you'd like to send email using an external provider - enter the new SMTP settings below.") }}
    </p>
    <p class="idno-admin-description">
        {{ t("After changing the mail settings, restart the queue worker: the mails it sends (the export and import results) use the settings it read when it started.") }}
    </p>

    <form action="{{ site_url() }}admin/email" method="post">
        <div class="idno-admin-card">
            <h2 class="idno-admin-card-title">{{ t('Email Settings') }}</h2>

            <p>{{ t('Fill in the site email address if you would like your site to send email.') }}</p>

            <div class="idno-form-group">
                <label class="idno-label" for="from_email">{{ t('Site email address') }}</label>
                <input type="text" id="from_email" name="from_email" class="idno-input"
                       placeholder="{{ t('Site email address') }}"
                       value="{{ setting('from_email') }}">
                <p class="idno-form-help">{{ t('This is the address that every email will be sent from.') }}</p>
            </div>
        </div>

        <div class="idno-admin-card">
            <h2 class="idno-admin-card-title">{{ t('SMTP Settings') }}</h2>

            <p>{{ t("You can often leave the following settings blank. However, you may wish to set them if you're using a third-party service to send email.") }}</p>

            <div class="idno-form-group">
                <label class="idno-label" for="smtp_host">{{ t('SMTP host') }}</label>
                <input type="text" id="smtp_host" name="smtp_host" class="idno-input"
                       placeholder="{{ t('SMTP host') }}"
                       value="{{ setting('smtp_host') }}">
                <p class="idno-form-help">{{ t('This is the address of the server that will send email for you.') }}</p>
            </div>

            <div class="idno-form-group">
                <label class="idno-label" for="smtp_username">{{ t('SMTP username') }}</label>
                <input type="text" id="smtp_username" name="smtp_username" class="idno-input"
                       placeholder="{{ t('SMTP username') }}"
                       value="{{ smtp_username }}">
                <p class="idno-form-help">{{ t('If your mail server needs a username, enter it here.') }}</p>
            </div>

            <div class="idno-form-group">
                <label class="idno-label" for="smtp_password">{{ t('SMTP password') }}</label>
                <input type="password" id="smtp_password" name="smtp_password" class="idno-input"
                       placeholder="{{ t('SMTP password') }}"
                       value="{{ smtp_password }}">
                <p class="idno-form-help">{{ t('If your mail server needs a password, enter it here.') }}</p>
            </div>

            <div class="idno-form-group">
                <label class="idno-label" for="smtp_port">{{ t('SMTP port') }}</label>
                {% set port = setting('smtp_port')|to_int %}{% if not port %}{% set port = 25 %}{% endif %}
                <input type="text" id="smtp_port" name="smtp_port" class="idno-input"
                       placeholder="25"
                       value="{{ port }}">
                <p class="idno-form-help">{{ t('This is normally 25 or 587.') }}</p>
            </div>

            <div class="idno-form-group">
                <label class="idno-label" for="smtp_secure">{{ t('Secure connection') }}</label>
                <select name="smtp_secure" id="smtp_secure" class="idno-input">
                    {% for field, value in {'No': false, 'Yes (TLS)': 'tls', 'Yes (SSL)': 'ssl'} %}
                        <option value="{{ value }}" {% if setting('smtp_secure') is same as(value) %}selected{% endif %}>{{ field }}</option>
                    {% endfor %}
                </select>
                <p class="idno-form-help">{{ t('Select yes if you use secure logins to your mail server.') }}</p>
            </div>
        </div>

        <div style="margin-top:var(--spacing-section)">
            <button type="submit" class="idno-btn idno-btn-primary">{{ t('Save settings') }}</button>
        </div>

        {{ form_token('/admin/email') }}
    </form>

    {% if setting('from_email') %}
    <div class="idno-admin-card" style="margin-top:var(--spacing-section)">
        <form action="{{ site_url() }}admin/emailtest" method="post">
            <h2 class="idno-admin-card-title">{{ t('Test Email') }}</h2>

            <div class="idno-form-group">
                <label class="idno-label" for="to_email">{{ t('Send a test message to') }}</label>
                <input type="text" id="to_email" name="to_email" class="idno-input"
                       placeholder="{{ t('To address') }}"
                       value="{{ setting('from_email') }}">
                <p class="idno-form-help">{{ t('Check your email settings by sending a test email.') }}</p>
            </div>

            <div style="margin-top:var(--spacing-section)">
                <button type="submit" class="idno-btn idno-btn-primary">{{ t('Test settings') }}</button>
            </div>

            {{ form_token('/admin/emailtest') }}
        </form>
    </div>
    {% endif %}
