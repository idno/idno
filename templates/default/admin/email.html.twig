{#- The email settings form: `values` (the fields as stored, or as the administrator typed them), `errors` (what is wrong with each field, by name), `has_password` (whether a password is stored: the password itself is never a variable), `configured`, `sender`, `test_to`, `fixed` (the mail settings the configuration file sets). -#}
{% macro field(name, label, help, values, errors, attributes) %}
    {% set attributes = attributes|default({}) %}
    <div class="idno-form-group">
        <label class="idno-label" for="{{ name }}">{{ label }}</label>
        <input id="{{ name }}" name="{{ name }}" class="idno-input" type="{{ attributes.type|default('text') }}" value="{{ values[name]|default('') }}"
               aria-describedby="help-{{ name }}{% if errors[name] is defined %} error-{{ name }}{% endif %}"{% if errors[name] is defined %} aria-invalid="true"{% endif %}
               {%- for attribute, value in attributes|filter((v, k) => k != 'type') %} {{ attribute }}="{{ value }}"{% endfor %}>
        {% if errors[name] is defined %}
            <p class="idno-form-error" id="error-{{ name }}">{{ errors[name] }}</p>
        {% endif %}
        <p class="idno-form-help" id="help-{{ name }}">{{ help }}</p>
    </div>
{% endmacro %}
{% import _self as form %}
{% set values = values|default({}) %}
{% set errors = errors|default({}) %}
<h1 class="idno-admin-page-title">{{ t('Email') }}</h1>
<p class="idno-admin-description">
    {{ t('Your site sends email to invite people, to reset passwords and to notify members. It sends it through a mail server: usually a mail service you have an account with.') }}
</p>
<p class="idno-admin-description">
    {{ t("After changing the mail settings, restart the queue worker: the mails it sends (the export and import results) use the settings it read when it started.") }}
</p>

{% if configured %}
    <div class="idno-notice idno-notice-ok" role="status">
        {{ t('Mail is sent through %s, from %s.', [setting('smtp_host'), sender]) }}
    </div>
{% else %}
    <div class="idno-notice idno-notice-warning" role="status">
        <strong>{{ t('No mail service is set up yet.') }}</strong>
        {{ t('Until you enter a mail server and a From address below, invitations and password reset emails will probably not arrive.') }}
    </div>
{% endif %}

{% if fixed %}
    <div class="idno-notice" role="note">
        {{ t("These settings are set in the site's configuration file (config.ini) or environment, which wins over what is saved here: %s. Change them there.", [fixed|join(', ')]) }}
    </div>
{% endif %}

<form action="{{ site_url() }}admin/email" method="post" id="mail-settings-form" novalidate>
    <div class="idno-admin-card">
        <h2 class="idno-admin-card-title">{{ t('Who the mail is from') }}</h2>

        {{ form.field('from_email', t('From address'), t('Every email is sent from this address. It must be one your mail service lets you send from.'), values, errors, {type: 'email', placeholder: 'hello@example.com', autocomplete: 'off', inputmode: 'email'}) }}
        {{ form.field('from_name', t('From name'), t("The name people see beside the address. Leave it empty to use the site's name."), values, errors, {placeholder: site_title(), maxlength: 100, autocomplete: 'off'}) }}
        {{ form.field('reply_to_email', t('Reply-To address (optional)'), t('Where replies go, if not to the From address: for example your own inbox.'), values, errors, {type: 'email', placeholder: 'you@example.com', autocomplete: 'off', inputmode: 'email'}) }}
    </div>

    <div class="idno-admin-card">
        <h2 class="idno-admin-card-title">{{ t('Mail server') }}</h2>

        {{ form.field('smtp_host', t('Server (SMTP host)'), t('The name of the mail server, as your mail service gives it: for example smtp.sendgrid.net.'), values, errors, {placeholder: 'smtp.example.com', autocomplete: 'off', autocapitalize: 'off', spellcheck: 'false', inputmode: 'url'}) }}

        <div class="idno-field-row">
            <div class="idno-form-group">
                <label class="idno-label" for="smtp_secure">{{ t('Security') }}</label>
                <select name="smtp_secure" id="smtp_secure" class="idno-select" aria-describedby="help-smtp_secure">
                    {% for value, label in {'tls': t('STARTTLS (usual, port 587)'), 'ssl': t('TLS (port 465)'), '': t('None (port 25)')} %}
                        <option value="{{ value }}"{% if (values.smtp_secure|default('')) is same as(value) %} selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
                <p class="idno-form-help" id="help-smtp_secure">{{ t('How the connection is encrypted. Mail services expect STARTTLS on port 587.') }}</p>
            </div>
            {{ form.field('smtp_port', t('Port'), t('Usually 587. Leave it empty to use the usual port for the security you chose.'), values, errors, {placeholder: '587', inputmode: 'numeric', autocomplete: 'off', maxlength: 5}) }}
        </div>

        {{ form.field('smtp_username', t('User name'), t('The user name your mail service gives you for SMTP. For some services it is a fixed word such as "apikey".'), values, errors, {autocomplete: 'off', autocapitalize: 'off', spellcheck: 'false'}) }}

        <div class="idno-form-group">
            <label class="idno-label" for="smtp_password">{{ t('Password') }}</label>
            <input type="password" id="smtp_password" name="smtp_password" class="idno-input" value=""
                   autocomplete="new-password" aria-describedby="help-smtp_password"
                   placeholder="{{ has_password|default(false) ? t('Saved. Type a new one to replace it') : '' }}">
            <p class="idno-form-help" id="help-smtp_password">
                {% if has_password|default(false) %}
                    <span class="idno-badge idno-badge-ok">{{ t('Saved') }}</span>
                    {{ t('A password is saved and is not shown here. Leave this empty to keep it, or type a new one to replace it.') }}
                {% else %}
                    {{ t('The password or API key for SMTP. It is stored on your site and never shown again.') }}
                {% endif %}
            </p>
            {% if has_password|default(false) %}
                <div class="idno-checkbox-group">
                    <input type="checkbox" id="smtp_password_remove" name="smtp_password_remove" value="1">
                    <label for="smtp_password_remove">{{ t('Remove the saved password') }}</label>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="idno-form-actions">
        <button type="submit" class="idno-btn idno-btn-primary">{{ t('Save settings') }}</button>
    </div>

    {{ form_token('/admin/email') }}
</form>

{{ idno_include('admin/email/services') }}

<div class="idno-admin-card" id="test">
    <form action="{{ site_url() }}admin/emailtest" method="post">
        <h2 class="idno-admin-card-title">{{ t('Send a test email') }}</h2>
        <p class="idno-form-help">{{ t('This sends one email with the settings as they are saved, and tells you what the mail server answered. Save your changes first.') }}</p>

        <div class="idno-form-group">
            <label class="idno-label" for="to_email">{{ t('Send it to') }}</label>
            <input type="email" id="to_email" name="to_email" class="idno-input" required
                   placeholder="you@example.com" inputmode="email"
                   value="{{ test_to|default('') }}">
        </div>

        <div class="idno-form-actions">
            <button type="submit" class="idno-btn">{{ t('Send test email') }}</button>
        </div>

        {{ form_token('/admin/emailtest') }}
    </form>
</div>

{{ idno_include('admin/email/script') }}
