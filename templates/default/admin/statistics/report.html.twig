{% set depth = level ? (level|to_int) : 1 %}{% for label, value in (report ?: []) %}{% if value is iterable %}

        <div class="form-group">
            <h{{ depth }}>{{ label }}</h{{ depth }}>
            {{ idno_include('admin/statistics/report', {report: value, level: depth + 1}) }}
        </div>

        {% if depth > 1 %}
            <hr style="clear: both"/>
            {% endif %}
    {% else %}

        <div class="form-group">
            <div class="col-md-3">
                <label class="control-label" for="inputName">{{ label }}</label>
            </div>
            <div class="col-md-9">
                <pre>{{ value }}</pre>
            </div>
        </div>
        {% endif %}{% endfor %}