{% set plugin = plugin|trim %}{% set version = version|trim %}{% set loaded_plugin = plugins_loaded[plugin] ?? false %}{% set details = plugins_stored[plugin] ?? null %}{% set plugin_version = details['Plugin description']['version'] ?? null %}{% set v_value = plugin_version ? version_compare(plugin_version, version|lower) : 0 %}{% set label = loaded_plugin ? 'label-success' : 'label-danger' %}{% if version and details and v_value < 0 %}{% set label = 'label-danger' %}{% endif %}<span class="label {{ label }}">{{ plugin }}{% if details %} v{{ details['Plugin description']['version'] }}{% endif %}{% if (version and v_value < 0) or (version and not details) %} {{ t('(v%s required)', [version]) }}{% endif %}</span> 