<h1 class="idno-admin-page-title">{{ t('Users') }}</h1>
    <p class="idno-admin-description">
        {{ t('View the users registered for your site, and invite new users to join.') }}
    </p>

    <div class="idno-admin-card">
        <h2 class="idno-admin-card-title">{{ t('Manage site users') }}</h2>
        <p>
            {{ t('Your site has') }} <strong>{{ count }}</strong>
            {% if count != 1 %}{{ t('users') }}{% else %}{{ t('user') }}{% endif %}.
        </p>

        {{ idno_include('forms/usersearch') }}
    </div>

    <div class="idno-admin-card" id="reserved-handles">
        <h2 class="idno-admin-card-title">{{ t('Usernames kept back') }}</h2>
        <p class="idno-admin-description">{{ t('These belonged to accounts that were deleted. Nobody can register them, so that nobody is taken for the member who had them. Release one to let someone register it.') }}</p>
        {% for reserved in reserved_handles|default([]) %}
            <div class="idno-admin-list-item">
                <div>{{ reserved.handle }} <small>{{ t('deleted') }} {{ reserved.at|date('M j, Y') }}</small></div>
                <div>{{ action_link(site_url() ~ 'admin/users', t('Release'), {handle: reserved.handle, action: 'release_handle'}, {class: 'idno-btn idno-btn-small', confirm: true, 'confirm-text': t('Are you sure? Anyone will be able to register this username, and will not be told apart from the member who had it in the likes and replies that member left on other posts.')}) }}</div>
            </div>
        {% else %}
            <p>{{ t('No usernames are kept back.') }}</p>
        {% endfor %}
        {% if reserved_handles_more|default(0) > 0 %}<p><small>{{ t('And more are kept back than are listed here.') }}</small></p>{% endif %}
    </div>

    {% if can_add_users() %}
    <div class="idno-admin-card" id="invite">
        <h2 class="idno-admin-card-title">{{ t('Invite people') }}</h2>
        {{ idno_include('admin/users/invite', {mail_configured: mail_configured|default(false), invitation_days: invitation_days|default(14), invitation_batch: invitation_batch|default(50)}) }}
    </div>
    {% endif %}

    {% if invitations %}
    <div class="idno-admin-card" id="invitations">
        <h2 class="idno-admin-card-title">{{ t('Invitations waiting to be accepted') }}</h2>
        {{ idno_include('admin/users/invitations', {invitations: invitations, invitation_days: invitation_days|default(14)}) }}
    </div>
    {% endif %}

    <div class="idno-admin-card">
        <form action="{{ site_url() }}admin/users" method="post">
            <h2 class="idno-admin-card-title">{{ t('Block email addresses') }}</h2>
            <p>
                {{ t('By blocking email addresses, you prevent people using those email addresses from registering on your site. Enter the email addresses you want to block below.') }}
            </p>
            <div class="idno-form-group">
                <textarea name="blocked_emails" class="idno-input" placeholder="user@email.com"></textarea>
            </div>
            <div class="idno-form-group">
                <button type="submit" class="idno-btn idno-btn-primary">{{ t('Block email addresses') }}</button>
                <input type="hidden" name="action" value="block_emails">
                {{ form_token('/admin/users') }}
            </div>
        </form>
    </div>

    {% set blocked_emails = setting('blocked_emails') %}
    {% if blocked_emails %}
    <div class="idno-admin-card">
        <h2 class="idno-admin-card-title">{{ t('Blocked email addresses') }}</h2>
        {% for email in blocked_emails %}
            <div class="idno-admin-list-item">
                <div>{{ email }}</div>
                <div>
                    <small>
                        {{ action_link(site_url() ~ 'admin/users', t('Remove block'), {blocked_emails: email, action: 'unblock_emails'}, {class: 'idno-btn idno-btn-small', confirm: true, 'confirm-text': "Are you sure? The user will be able to log in and post again."}) }}
                    </small>
                </div>
            </div>
        {% endfor %}
    </div>
    {% endif %}

    {{ idno_include('admin/users/extensions') }}
