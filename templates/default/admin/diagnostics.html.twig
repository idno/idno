<div class="row">
    <div class="col-md-10 col-md-offset-1">
        {{ idno_include('admin/menu') }}
        <h1>{{ t('Diagnostics') }}</h1>


        <div class="explanation">
            <p>
                {{ t('This page provides you with information that may help you or others diagnose any problems you may be experiencing with your Idno install.') }}
            </p>
        </div>
        
        <div id="diagnostics-basic">
        {% if basics.status != 'Ok' %}
            {% for item, details in basics.report %}
                {% if details.status != 'Ok' %}
                    {% set statusName = details.status|lower %}
                    {% if statusName in ['fail', 'failure', 'danger', 'error'] %}{% set class = 'danger' %}{% elseif statusName in ['warn', 'warning'] %}{% set class = 'warning' %}{% elseif statusName == 'ok' %}{% set class = 'success' %}{% else %}{% set class = 'info' %}{% endif %}
            <div class="alert alert-{{ class }}">{{ details.message|raw }}</div>
                {% endif %}
            {% endfor %}
        {% else %}
            <div class="alert alert-success">{{ t('Basic checks on installation discovered no problems.') }}</div>
        {% endif %}
        </div>
    
        <div id="diagnostics-report" hidden>
            <small><pre id="diagnostics-report-text" style="overflow: auto; height: 500px;"></pre></small>
        </div>

        <button type="button" class="btn btn-primary" id="diagnostics-report-run">{{ t('Generate detailed report') }}</button>

    </div>

</div>

<script>
    (function () {
        var button = document.getElementById('diagnostics-report-run');
        var report = document.getElementById('diagnostics-report');
        var text = document.getElementById('diagnostics-report-text');
        if (!button || !report || !text) {
            return;
        }
        button.addEventListener('click', function () {
            button.textContent = '{{ t('Generating...')|e('js') }}';
            button.disabled = true;
            // The page answers an XMLHttpRequest with the report as plain text.
            fetch('{{ current_url()|e('js') }}', {credentials: 'same-origin', headers: {'X-Requested-With': 'XMLHttpRequest'}})
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error(String(response.status));
                    }
                    return response.text();
                })
                .then(function (body) {
                    text.textContent = body;
                    button.hidden = true;
                    report.hidden = false;
                })
                .catch(function () {
                    button.textContent = '{{ t('Generate detailed report')|e('js') }}';
                    button.disabled = false;
                });
        });
    })();
</script>
