{% set shell = shell_variables() %}
{% do idno_include('shell/headers', shell) %}
<!DOCTYPE html>
<html lang="{{ shell.lang }}"{% if shell.html_className %} class="h-feed"{% endif %}>
<head>
{% block head %}
{{- idno_include('shell/metatags', shell) -}}
{% set icon_user = page_icon_user() %}{% if icon_user %}{% set shell = shell|merge({user: icon_user}) %}{% endif %}
{{- idno_include('shell/icons', shell) -}}
{{- idno_include('shell/favicon', shell) -}}
{{- idno_include('shell/webapp', shell) -}}
{{- idno_include('shell/opengraph', shell) -}}
{{- idno_include('shell/structured-data', shell) -}}
{{- idno_include('shell/dublincore', shell) -}}
{{- idno_include('shell/amp', shell) -}}
{{- idno_include('shell/bootstrap', shell) -}}
{{- idno_include('shell/javascript', shell) -}}
{{- idno_include('shell/css', shell) -}}
{{- idno_include('shell/activitypub', shell) -}}
{{- idno_include('shell/syndication', shell) -}}
{{- idno_include('shell/identities', shell) -}}
{{- idno_include('shell/head', shell) -}}
{{- idno_include('shell/monetization', shell) -}}
{{- idno_include('shell/head/final', shell) -}}
{% endblock %}
</head>
<body class="{{ body_classes() }}">
    <div class="idno-shell">
        {% block nav %}{{ idno_include('shell/nav', shell) }}{% endblock %}
        <main class="idno-main">
            <div class="idno-feed h-feed">
                {% block content %}{{ idno_include('shell/messages', shell) }}
                <a name="pagecontent"></a>
                {{ idno_include('shell/beforecontent', shell) -}}
                {%- if shell.body %}{{ shell.body|raw }}{% endif -%}
                {{- idno_include('shell/aftercontent', shell) }}{% endblock %}
            </div>
        </main>
        <div class="idno-spacer" aria-hidden="true"></div>
    </div>
    {% block footer %}{{ idno_include('shell/aftercontainer', shell) }}
    {{ idno_include('shell/contentfooter', shell) }}
    {{ idno_include('shell/search', shell) }}
    {{ idno_include('shell/compose', shell) }}
{{ idno_include('shell/assets', shell) -}}
{{- idno_include('shell/footerjavascript', shell) -}}
{{- idno_include('shell/footer', shell) -}}
{{- idno_include('shell/form-data', shell) -}}
{% endblock %}</body>
</html>
