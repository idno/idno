{#- Shown on the password reset pages when the site has no mail service: the email would probably not arrive, and the visitor should know whom to ask. It says the same to everyone and nothing about any account. -#}
{% if mail_configured is defined and not mail_configured %}
<div class="idno-notice idno-notice-warning" role="status">
    {{ t("This site isn't set up to send email yet, so a reset email may not reach you. If it doesn't arrive, ask an administrator of the site for help.") }}
</div>
{% endif %}
