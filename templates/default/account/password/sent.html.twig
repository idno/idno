{#- The page after a reset link was asked for: the same for every address. `mail_configured`: whether the site has a mail service to send through. -#}
<div class="idno-gate">
    <div class="idno-editor">
        <h1 class="idno-editor-heading">{{ t('Check your inbox') }}</h1>
        <p class="idno-gate-lead">{{ t('If there is an account with that email address, we have sent it a link to choose a new password. The link works for three hours.') }}</p>
        {{ idno_include('account/password/nomail') }}
        <div class="idno-gate-actions">
            <a class="idno-btn idno-btn-primary" href="{{ site_url() }}session/login">{{ t('Back to sign in') }}</a>
        </div>
    </div>
</div>
