{#- The form that sets the new password. `email` and `code` come from the reset link, or from the form that was refused; they are drawn on a copy of the page's template, so neither is a variable of the page. The passwords are never printed. -#}
<div class="idno-gate">
    <div class="idno-editor">
        <h1 class="idno-editor-heading">{{ t('Choose a new password') }}</h1>

        <form action="{{ site_url() }}account/password/reset" method="post">
            <div class="idno-form-field">
                <label class="idno-label" for="reset-email">{{ t('Your email address') }}</label>
                <input type="email" id="reset-email" name="email" class="idno-input" readonly required autocomplete="username"
                       value="{{ email|default('') }}">
            </div>
            <div class="idno-form-field">
                <label class="idno-label" for="reset-password">{{ t('New password') }}</label>
                <input type="password" id="reset-password" name="password" class="idno-input" required minlength="7" autofocus
                       autocomplete="new-password" aria-describedby="reset-password-help">
                <p class="idno-form-help" id="reset-password-help">{{ t('At least 7 characters.') }}</p>
            </div>
            <div class="idno-form-field">
                <label class="idno-label" for="reset-password2">{{ t('Your new password again') }}</label>
                <input type="password" id="reset-password2" name="password2" class="idno-input" required minlength="7"
                       autocomplete="new-password">
            </div>
            <div class="idno-gate-actions">
                <button type="submit" class="idno-btn idno-btn-primary">{{ t('Save new password') }}</button>
            </div>
            <input type="hidden" name="code" value="{{ code|default('') }}">
            {{ form_token('/account/password/reset') }}
        </form>
    </div>
</div>
