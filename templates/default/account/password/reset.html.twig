<div class="row">

    <div class="col-md-10 col-md-offset-1">

        <h1>{{ t('Reset your password') }}</h1>
        <p>
            {{ t('To change your password, enter your new password below:') }}
        </p>

    </div>
    <div class="col-md-10 col-md-offset-1">

        <form action="{{ site_url() }}account/password/reset" method="post" class="form-horizontal">

            <div class="control-group">
                <label class="control-label" for="inputEmail">{{ t('Your email address') }}<br />
                    <small>{{ t('The address associated with your %s account.', [setting('title')]) }}</small></label>
                <div class="controls">
                    <input type="email" id="inputEmail" placeholder="Email" class="form-control" name="email" value="{{ email }}" required>
                </div>
            </div>
            <div class="control-group">
                <label class="control-label" for="inputPassword">{{ t('New password (7 characters or more)') }}</label>
                <div class="controls">
                    <input type="password" id="inputPassword" class="form-control" name="password" value="" required>
                </div>
            </div>
            <div class="control-group">
                <label class="control-label" for="inputPassword2">{{ t('Retype password') }}<br />
                    <small>{{ t('We ask you to enter the password twice to protect against typos.') }}</small></label>
                <div class="controls">
                    <input type="password" id="inputPassword2" class="form-control" name="password2" value="" required>
                </div>
            </div>
            <div class="control-group">
                <div class="controls">
                    <button type="submit" class="btn btn-primary">{{ t('Reset password') }}</button>
                    <input type="hidden" name="code" value="{{ code }}">
                    {{ form_token('/account/password/reset') }}
                </div>
            </div>

        </form>

    </div>

</div>
