<div class="row">

    <div class="col-md-10 col-md-offset-1">
        <h1>
            {{ t('Share your feedback') }}
        </h1>
        <!--{{ idno_include('account/menu') }}-->
        <p class="explanation">
            {{ t("Want to share something with the Idno team? We'd love to read your thoughts, suggestions, or ideas. We will personally read all of your feedback.") }}
        </p>
        
    </div>
</div>

<form class="form-horizontal" action="{{ site_url() }}account/settings/feedback"
      method="post">
    <div class="row">
        <div class="col-md-10 col-md-offset-1">

            <p class="feedback">
                <strong>{{ t('From') }}:</strong> {{ entity_value(current_user(), 'email') }}
                <input type="hidden" name="email"
                       value="{{ entity_value(current_user(), 'email') }}">
            </p>

            <p class="feedback"><strong>To:</strong> feedback@idno.co</p>
            <br>

            <p class="feedback"><strong>Subject:</strong> {{ t('Feedback for the Idno team') }}</p>

            <div class="control-group">
                <textarea rows="7" class="feedback" placeholder="{{ t('Let us know what you think.') }}" name="message" required></textarea>

                <div class="control-group">
                    <div class="feedback-btn">
                        {{ form_token('/account/settings/feedback') }}
                        <input type="submit" class="btn btn-primary" value="{{ t('Send feedback') }}">
                    </div>
                </div>


            </div>
        </div>
    </div>
</form>
