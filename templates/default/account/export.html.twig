<h1 class="idno-admin-page-title">
    {{ t('Export your data') }}</h1>

<div class="idno-admin-card">
    <form action="{{ site_url() }}account/export/rss" method="post">

        <h2>{{ t('Export as RSS') }}</h2>
        <p class="idno-admin-description">
            {{ t("You can download an RSS version of everything you've posted on this site. This file is suitable for importing into content management systems like WordPress, or another Idno site.") }}
        </p>

        <div class="idno-form-group">
            <label>
                <input type="checkbox" name="allposts" id="allposts" value="1">
                {{ t('Include private posts?') }}
            </label>
            <p class="idno-form-help">{{ t('Platforms like WordPress may assume that all your posts should be displayed publicly. In order to protect your privacy, you may wish to just download your public posts.') }}</p>
        </div>

        <div class="idno-form-actions">
            <button type="submit" class="idno-btn-primary">{{ t('Download RSS Feed') }}</button>
        </div>

        {{ form_token('/account/export/rss') }}
    </form>
</div>

<div class="idno-admin-card" style="margin-top: 1.5rem;">
    <form action="{{ site_url() }}account/export/wxr" method="post">

        <h2>{{ t('Export as WordPress (WXR)') }}</h2>
        <p class="idno-admin-description">
            {{ t('Download a WordPress eXtended RSS (WXR) file. This format includes additional metadata such as post dates, slugs, and comments, and is the standard format for importing into WordPress.') }}
        </p>

        <div class="idno-form-group">
            <label>
                <input type="checkbox" name="allposts" id="allposts_wxr" value="1">
                {{ t('Include private posts?') }}
            </label>
            <p class="idno-form-help">{{ t('Platforms like WordPress may assume that all your posts should be displayed publicly. In order to protect your privacy, you may wish to just download your public posts.') }}</p>
        </div>

        <div class="idno-form-actions">
            <button type="submit" class="idno-btn-primary">{{ t('Download WXR File') }}</button>
        </div>

        {{ form_token('/account/export/wxr') }}
    </form>
</div>
