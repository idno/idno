{#- The registration form. `invited` (the person arrived with an invitation), `email` (the invitation's address when invited: it cannot be changed here), `code`, `name`, `handle` (what was typed before a refusal; never a password), `inviter` (the name of whoever invited them), `is_admin` (the invitation is an administrator's). -#}
{% set invited = invited|default(false) %}
<div class="idno-gate idno-gate-wide">
    <div class="idno-editor">
        <h1 class="idno-editor-heading">
            {% if invited %}{{ t('Join %s', [site_title()]) }}{% else %}{{ t('Create your account') }}{% endif %}
        </h1>

        {% if invited %}
            <p class="idno-gate-lead">
                {% if inviter|default('') %}
                    {{ t('%s invited you. Choose a name, a handle and a password to finish setting up your account.', [inviter]) }}
                {% else %}
                    {{ t('You have been invited. Choose a name, a handle and a password to finish setting up your account.') }}
                {% endif %}
            </p>
            {% if is_admin|default(false) %}
                <div class="idno-notice" role="note">
                    <strong>{{ t('You are invited as an administrator.') }}</strong>
                    {{ t("Administrators can change the site's settings, manage its members and see everything posted here.") }}
                </div>
            {% endif %}
        {% endif %}

        <form action="{{ site_url() }}account/register" method="post">
            <div class="idno-form-field">
                <label class="idno-label" for="register-email">{{ t('Your email address') }}</label>
                <input type="email" id="register-email" name="email" class="idno-input" required
                       value="{{ email|default('') }}" autocapitalize="off" autocomplete="email"
                       {%- if invited %} readonly aria-describedby="register-email-help"{% endif %}>
                {% if invited %}
                    <p class="idno-form-help" id="register-email-help">{{ t("The invitation is for this address, so it can't be changed here. You can change it in your settings afterwards.") }}</p>
                {% endif %}
            </div>

            <div class="idno-form-field">
                <label class="idno-label" for="register-name">{{ t('Your name') }}</label>
                <input type="text" id="register-name" name="name" class="idno-input" autocomplete="name" value="{{ name|default('') }}">
            </div>

            <div class="idno-form-field">
                <label class="idno-label" for="register-handle">{{ t('Choose a handle') }}</label>
                <input type="text" id="register-handle" name="handle" class="idno-input" required maxlength="32"
                       pattern="[A-Za-z0-9_]+" autocapitalize="off" autocorrect="off" spellcheck="false" autocomplete="username"
                       aria-describedby="register-handle-help" value="{{ handle|default('') }}">
                <p class="idno-form-help" id="register-handle-help">{{ t("Your handle identifies you on the site and is part of your profile's address. Letters, numbers and underscores: for example, janedoe.") }}</p>
            </div>

            <div class="idno-form-field">
                <label class="idno-label" for="register-password">{{ t('Create a password') }}</label>
                <input type="password" id="register-password" name="password" class="idno-input" required minlength="7"
                       autocomplete="new-password" aria-describedby="register-password-help">
                <p class="idno-form-help" id="register-password-help">{{ t('At least 7 characters.') }}</p>
            </div>

            <div class="idno-form-field">
                <label class="idno-label" for="register-password2">{{ t('Your password again') }}</label>
                <input type="password" id="register-password2" name="password2" class="idno-input" required minlength="7" autocomplete="new-password">
            </div>

            {{ idno_include('forms/input/captcha', {action: '/account/register'}) }}

            <div class="idno-gate-actions">
                <button type="submit" class="idno-btn idno-btn-primary">{{ t('Create account') }}</button>
            </div>
            <input type="hidden" name="code" value="{{ code|default('') }}">
            {{ form_token('/account/register') }}
        </form>

        <p class="idno-gate-foot">
            <a href="{{ site_url() }}session/login">{{ t('Already have an account? Sign in') }}</a>
        </p>
    </div>
</div>
