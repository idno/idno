<div style="max-width:24rem;margin:2rem auto">
    <div class="idno-editor" style="text-align:center">
        <h4 class="idno-editor-heading">
            {{ t('Welcome back!') }}
        </h4>

        <form action="{{ site_url() }}session/login" method="post">
            <div class="idno-form-field">
                <input type="text" name="email" autofocus
                       class="idno-input" style="text-align:left"
                       placeholder="{{ t('Your email address or username') }}">
            </div>
            <div class="idno-form-field">
                <input type="password" name="password"
                       class="idno-input" style="text-align:left"
                       placeholder="{{ t('Password') }}">
            </div>

            {{ idno_include('forms/input/captcha', {action: '/session/login'}) }}

            <div class="idno-form-field">
                <button type="submit" class="idno-btn idno-btn-primary" style="width:100%">
                    {{ t('Sign in') }}
                </button>
                <input type="hidden" name="fwd" value="{% if fwd %}{{ fwd }}{% elseif referrer() %}{{ referrer() }}{% else %}{{ site_url() }}{% endif %}">
            </div>

            {{ form_token('/session/login') }}
        </form>

        <div style="margin-top:1rem;font-size:var(--font-size-sm);color:var(--color-text-muted)">
            <a href="{{ site_url() }}account/password" style="color:inherit">
                {{ t('Forgot your password?') }}
            </a>
            {% if setting('open_registration') == true and can_add_users() %}
                <span style="margin:0 0.25rem">&middot;</span>
                <a href="{{ site_url() }}account/register" style="color:inherit">
                    {{ t('Register') }}
                </a>
            {% endif %}
        </div>
    </div>
</div>
