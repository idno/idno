{#- The page that asks for a password reset link. `mail_configured`: whether the site has a mail service to send through. -#}
<div class="idno-gate">
    <div class="idno-editor">
        <h1 class="idno-editor-heading">{{ t('Reset your password') }}</h1>
        <p class="idno-gate-lead">{{ t('Enter the email address of your %s account, and we will send you a link to choose a new password.', [setting('title')]) }}</p>

        {{ idno_include('account/password/nomail') }}

        <form action="{{ site_url() }}account/password" method="post">
            <div class="idno-form-field">
                <label class="idno-label" for="reset-email">{{ t('Your email address') }}</label>
                <input type="email" id="reset-email" name="email" class="idno-input" required autofocus
                       autocomplete="email" autocapitalize="off" placeholder="you@example.com">
            </div>
            {{ idno_include('forms/input/captcha', {action: '/account/password'}) }}
            <div class="idno-gate-actions">
                <button type="submit" class="idno-btn idno-btn-primary">{{ t('Send password reset email') }}</button>
            </div>
            {{ form_token('/account/password') }}
        </form>

        <p class="idno-gate-foot">
            <a href="{{ site_url() }}session/login">{{ t('Back to sign in') }}</a>
        </p>
    </div>
</div>
