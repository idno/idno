<div id="form-main">
    <div id="form-div">
        <h2>{{ t('Share to social') }}</h2>

        <p class="social-connect">
            {{ t('Connect your accounts to easily share content with people across the web.') }}
        </p>

        {{ idno_include('onboarding/connect/networks') }}

        <div class="col-md-12 next-bar" align="center">
            <button class="btn btn-primary btn-lg btn-responsive"
                    onclick="window.location = {{ js_string(site_url() ~ 'begin/publish') }}; return false;">
                {{ t('Continue') }}
            </button>
        </div>

        <p align="center">
            {{ t("Don't worry, you can always connect these later.") }}
        </p>

    </div>
</div>
