{% set uid = 'f' ~ random_id()|slice(0, 13) %}{% set method = method in ['GET', 'POST', 'PUT', 'DELETE'] ? method : 'POST' %}{% set link_url = url|link_url %}<a data-form-id="{{ uid }}" {% if class %} class="{{ class }}" {% endif %} {% if title %} title="{{ title }}" {% endif %} href="{{ link_url }}" onclick="{% if confirm %}if (confirm({{ js_string(_context['confirm-text'] ?? '') }})) { document.getElementById('{{ uid }}').submit(); return false; } else { return false; } {% else %}document.getElementById('{{ uid }}').submit(); return false; {% endif %}">{{ label|raw }}</a>
{% set form %}<form action="{{ link_url }}" style="display: none; margin: 0; padding: 0" id="{{ uid }}" method="{{ method }}">
    <textarea name="json">{{ data|json_encode }}</textarea>
    {{ form_token(link_url) }}
</form>
{% endset %}{{ form_data(form) }}
{% do forget_variables(['confirm-text', 'class', 'confirm', 'url', 'method', 'data', 'label', 'id']) %}