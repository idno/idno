{#- The plain-text twin of templates/email/admin/import_failure. -#}
{%- set site = mail_site_name() -%}
{{- idno_include('parts/heading', {text: t('Your import did not finish')}) -}}
{%- if stopped -%}
{{- idno_include('parts/paragraph', {text: t("The import was stopped after repeated errors. %s posts were imported before it stopped. Check the site's log for the cause, and check your posts before you import the file again, or it may add them twice.", [(imported|default(0))|to_int])}) -}}
{%- elseif startedBefore -%}
{{- idno_include('parts/paragraph', {text: t('This import was started before and did not finish, so it was not run again: running it again would import its posts twice. Some posts may already have been imported. Check your posts first; if posts are missing, upload the file again.')}) -}}
{%- else -%}
{{- idno_include('parts/paragraph', {format: t_format('Some or all of the file you uploaded to %s could not be imported.'), values: [site]}) -}}
{{- idno_include('parts/paragraph', {text: t("Some posts may already have been imported. Check your posts before you import the file again, or it may add them twice. If it fails again, the site's error log may say why.")}) -}}
{%- endif -%}
{{- idno_include('parts/button', {label: t('Try the import again'), url: site_url() ~ 'admin/import/'}) -}}
